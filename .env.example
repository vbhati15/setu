# Copy to .env and fill in real values. Never commit .env.

# --- App mode ---
# "test" keeps Razorpay + payments in test-mode and enforces lower spend limits.
# "live" is structurally supported but intentionally unused/blocked in code today.
SETU_ENV=test

# --- Razorpay (test-mode keys from https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Gemini (Google AI Studio free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-lite-latest

# --- Database ---
DATABASE_URL=postgresql://setu:setu@localhost:5432/setu

# --- Merchant identity (used in x402 PaymentRequirements.payTo) ---
MERCHANT_ID=setu_merchant_test

# --- CORS (JSON array of allowed browser origins) ---
# Override if the deployed frontend's origin changes.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","https://setu-alpha-beige.vercel.app"]

# --- Admin (kill switch) ---
# Required as the X-ADMIN-KEY header on POST /admin/kill-switch/*.
# Generate a real random value for deployment -- never use the default outside local dev.
ADMIN_API_KEY=changeme-admin-key
